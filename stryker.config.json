{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "_comment": "Opt-in mutation testing, run with `npm run mutation`. Every mutant runs the tests of the mutated modules through the command runner on the Node.js test runner, which loads the instrumented TypeScript sources through tsx. The long test timeout keeps the slower instrumented code from failing tests by timeout, which would count as a killed mutant",
    "testRunner": "command",
    "commandRunner": {
        "command": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 --test-reporter=dot \"test/dkim/**/*-test.ts\" \"test/spf/**/*-test.ts\" \"test/dmarc/**/*-test.ts\" \"test/dkim2/**/*-test.ts\" \"test/property/*-test.ts\" test/mailauth-test.ts"
    },
    "coverageAnalysis": "off",
    "mutate": ["src/dkim/body/*.ts", "src/spf/macro.ts", "src/dmarc/author-domain.ts", "src/dkim2/*.ts"],
    "reporters": ["clear-text", "progress", "html", "json"],
    "htmlReporter": {
        "fileName": "reports/mutation/mutation.html"
    },
    "jsonReporter": {
        "fileName": "reports/mutation/mutation.json"
    },
    "tempDirName": ".stryker-tmp",
    "cleanTempDir": true,
    "timeoutMS": 60000
}
